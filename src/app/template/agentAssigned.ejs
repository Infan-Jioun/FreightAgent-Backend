<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Shipment Assigned - FreightAgent</title>
</head>

<body style="margin:0; padding:0; font-family: 'Segoe UI', Arial, sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#0a0f0f; padding: 40px 0;">
        <tr>
            <td align="center">
                <table width="520" cellpadding="0" cellspacing="0" style="
                    background: linear-gradient(145deg, #0d1f1f, #112a2a);
                    border-radius: 16px;
                    border: 1px solid #1a4a4a;
                    overflow: hidden;
                    box-shadow: 0 0 40px rgba(0,200,180,0.08);
                ">
                    <!-- Top accent bar -->
                    <tr>
                        <td style="height: 4px; background: linear-gradient(90deg, #00c9a7, #00e5c0, #00b4d8);"></td>
                    </tr>

                    <!-- Logo -->
                    <tr>
                        <td align="center" style="padding: 36px 40px 0;">
                            <div style="
                                display: inline-block;
                                background: linear-gradient(135deg, #00c9a7, #00b4d8);
                                border-radius: 12px;
                                padding: 10px 20px;
                            ">
                                <span style="color: #0a0f0f; font-size: 18px; font-weight: 800; letter-spacing: 1px;">
                                    ⚓ FreightAgent
                                </span>
                            </div>
                        </td>
                    </tr>

                    <!-- Icon -->
                    <tr>
                        <td align="center" style="padding: 28px 40px 0;">
                            <div style="font-size: 48px;">🚚</div>
                        </td>
                    </tr>

                    <!-- Title -->
                    <tr>
                        <td align="center" style="padding: 16px 40px 0;">
                            <h1 style="
                                margin: 0;
                                color: #e0faf5;
                                font-size: 24px;
                                font-weight: 700;
                                letter-spacing: 0.5px;
                            ">New Road Shipment Assigned!</h1>
                            <p style="margin: 10px 0 0; color: #7ecfc4; font-size: 14px;">
                                Hello Road Agent, <strong style="color:#00e5c0;">
                                    <%= agentName %>
                                </strong>!
                                A new shipment on your route has been assigned to you by Admin.
                            </p>
                        </td>
                    </tr>

                    <!-- Tracking ID Badge -->
                    <tr>
                        <td align="center" style="padding: 20px 40px 0;">
                            <div style="
                                background: rgba(0,229,192,0.1);
                                border: 1px solid #00e5c0;
                                border-radius: 12px;
                                padding: 12px 24px;
                            ">
                                <p style="
                                    margin: 0 0 4px;
                                    color: #7ecfc4;
                                    font-size: 11px;
                                    letter-spacing: 2px;
                                    text-transform: uppercase;
                                ">Tracking ID</p>
                                <p style="
                                    margin: 0;
                                    color: #00e5c0;
                                    font-size: 20px;
                                    font-weight: 800;
                                    letter-spacing: 3px;
                                ">
                                    <%= trackingId %>
                                </p>
                            </div>
                        </td>
                    </tr>

                    <!-- Shipment Details Table -->
                    <tr>
                        <td align="center" style="padding: 24px 40px;">
                            <div style="
                                background: #0a1a1a;
                                border: 1px solid #1a4a4a;
                                border-radius: 12px;
                                padding: 24px 32px;
                                text-align: left;
                            ">
                                <p style="
                                    margin: 0 0 16px;
                                    color: #7ecfc4;
                                    font-size: 12px;
                                    letter-spacing: 2px;
                                    text-transform: uppercase;
                                ">Shipment & Route Information</p>

                                <table width="100%" cellpadding="0" cellspacing="0">
                                    <tr>
                                        <td style="padding: 8px 0;">
                                            <span style="color:#3a6b66; font-size:13px;">📍 Origin / Pickup Address</span>
                                        </td>
                                        <td align="right">
                                            <span style="color:#00e5c0; font-size:13px; font-weight:600;">
                                                <%= origin %>
                                            </span>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="padding: 8px 0; border-top: 1px solid #1a4a4a;">
                                            <span style="color:#3a6b66; font-size:13px;">🏁 Destination Address</span>
                                        </td>
                                        <td align="right" style="border-top: 1px solid #1a4a4a;">
                                            <span style="color:#00e5c0; font-size:13px; font-weight:600;">
                                                <%= destination %>
                                            </span>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="padding: 8px 0; border-top: 1px solid #1a4a4a;">
                                            <span style="color:#3a6b66; font-size:13px;">⚖️ Weight</span>
                                        </td>
                                        <td align="right" style="border-top: 1px solid #1a4a4a;">
                                            <span style="color:#00e5c0; font-size:13px; font-weight:600;">
                                                <%= weight %> kg
                                            </span>
                                        </td>
                                    </tr>

                                    <% if (description) { %>
                                    <tr>
                                        <td style="padding: 8px 0; border-top: 1px solid #1a4a4a;">
                                            <span style="color:#3a6b66; font-size:13px;">📄 Description</span>
                                        </td>
                                        <td align="right" style="border-top: 1px solid #1a4a4a;">
                                            <span style="color:#00e5c0; font-size:13px; font-weight:600;">
                                                <%= description %>
                                            </span>
                                        </td>
                                    </tr>
                                    <% } %>

                                    <tr>
                                        <td style="padding: 8px 0; border-top: 1px solid #1a4a4a;">
                                            <span style="color:#3a6b66; font-size:13px;">👤 Customer</span>
                                        </td>
                                        <td align="right" style="border-top: 1px solid #1a4a4a;">
                                            <span style="color:#00e5c0; font-size:13px; font-weight:600;">
                                                <%= customerName %>
                                            </span>
                                            <% if (customerPhone) { %>
                                            <br />
                                            <span style="color:#7ecfc4; font-size:12px;">📞 <%= customerPhone %></span>
                                            <% } %>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="padding: 8px 0; border-top: 1px solid #1a4a4a;">
                                            <span style="color:#3a6b66; font-size:13px;">👑 Assigned By (Admin)</span>
                                        </td>
                                        <td align="right" style="border-top: 1px solid #1a4a4a;">
                                            <span style="color:#00e5c0; font-size:13px; font-weight:600;">
                                                <%= assignedByName %>
                                            </span>
                                            <br />
                                            <span style="color:#3a6b66; font-size:11px;">
                                                <%= assignedByEmail %>
                                            </span>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="padding: 8px 0; border-top: 1px solid #1a4a4a;">
                                            <span style="color:#3a6b66; font-size:13px;">🕒 Assigned At</span>
                                        </td>
                                        <td align="right" style="border-top: 1px solid #1a4a4a;">
                                            <span style="color:#00e5c0; font-size:13px; font-weight:600;">
                                                <%= assignedAt %>
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </td>
                    </tr>

                    <!-- CTA Button -->
                    <tr>
                        <td align="center" style="padding: 0 40px 32px;">
                            <a href="<%= dashboardUrl %>/agent/shipments" style="
                                display: inline-block;
                                background: linear-gradient(135deg, #00c9a7, #00b4d8);
                                color: #0a0f0f;
                                font-size: 14px;
                                font-weight: 800;
                                text-decoration: none;
                                padding: 14px 36px;
                                border-radius: 10px;
                                letter-spacing: 0.5px;
                            ">
                                View in Agent Portal →
                            </a>
                        </td>
                    </tr>

                    <!-- Divider -->
                    <tr>
                        <td style="padding: 0 40px;">
                            <div style="border-top: 1px solid #1a4a4a;"></div>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="padding: 24px 40px 32px;">
                            <p style="margin: 0; color: #3a6b66; font-size: 12px; line-height: 1.6;">
                                Please login to your Agent dashboard to accept this assignment and begin transit updates.
                            </p>
                            <p style="margin: 8px 0 0; color: #3a6b66; font-size: 11px;">
                                © 2026 FreightAgent. All rights reserved.
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

</body>

</html>
