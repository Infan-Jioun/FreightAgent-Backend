<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Role Updated - FreightAgent</title>
</head>

<body style="margin:0; padding:0; font-family: 'Segoe UI', Arial, sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#0a0f0f; padding: 40px 0;">
        <tr>
            <td align="center">
                <table width="520" cellpadding="0" cellspacing="0" style="
                    background: linear-gradient(145deg, #0d1f1f, #112a2a);
                    border-radius: 16px;
                    border: 1px solid #1a4a4a;
                    overflow: hidden;
                    box-shadow: 0 0 40px rgba(0,200,180,0.08);
                ">
                    <!-- Top accent bar -->
                    <tr>
                        <td style="height: 4px; background: linear-gradient(90deg, #00c9a7, #00e5c0, #00b4d8);"></td>
                    </tr>

                    <!-- Logo -->
                    <tr>
                        <td align="center" style="padding: 36px 40px 0;">
                            <div style="
                                display: inline-block;
                                background: linear-gradient(135deg, #00c9a7, #00b4d8);
                                border-radius: 12px;
                                padding: 10px 20px;
                            ">
                                <span style="color: #0a0f0f; font-size: 18px; font-weight: 800; letter-spacing: 1px;">
                                    ⚓ FreightAgent
                                </span>
                            </div>
                        </td>
                    </tr>

                    <!-- Icon -->
                    <tr>
                        <td align="center" style="padding: 28px 40px 0;">
                            <div style="font-size: 48px;">🔄</div>
                        </td>
                    </tr>

                    <!-- Title -->
                    <tr>
                        <td align="center" style="padding: 16px 40px 0;">
                            <h1 style="
                                margin: 0;
                                color: #e0faf5;
                                font-size: 24px;
                                font-weight: 700;
                                letter-spacing: 0.5px;
                            ">Your Role Has Been Updated!</h1>
                            <p style="margin: 10px 0 0; color: #7ecfc4; font-size: 14px;">
                                Hello, <strong style="color:#00e5c0;">
                                    <%= name %>
                                </strong>!
                                Your account role has been updated by an administrator.
                            </p>
                        </td>
                    </tr>

                    <!-- Role Change Info -->
                    <tr>
                        <td align="center" style="padding: 28px 40px;">
                            <div style="
                                background: #0a1a1a;
                                border: 1px solid #1a4a4a;
                                border-radius: 12px;
                                padding: 24px 32px;
                                text-align: left;
                            ">
                                <p style="
                                    margin: 0 0 16px;
                                    color: #7ecfc4;
                                    font-size: 12px;
                                    letter-spacing: 2px;
                                    text-transform: uppercase;
                                ">Role Change Details</p>

                                <table width="100%" cellpadding="0" cellspacing="0">
                                    <!-- Name -->
                                    <tr>
                                        <td style="padding: 8px 0;">
                                            <span style="color:#3a6b66; font-size:13px;">👤 Name</span>
                                        </td>
                                        <td align="right">
                                            <span style="color:#00e5c0; font-size:13px; font-weight:600;">
                                                <%= name %>
                                            </span>
                                        </td>
                                    </tr>

                                    <!-- Previous Role -->
                                    <tr>
                                        <td style="padding: 8px 0; border-top: 1px solid #1a4a4a;">
                                            <span style="color:#3a6b66; font-size:13px;">⬅️ Previous Role</span>
                                        </td>
                                        <td align="right" style="border-top: 1px solid #1a4a4a;">
                                            <span style="
                                                color: #ff6b6b;
                                                font-size: 13px;
                                                font-weight: 600;
                                                text-decoration: line-through;
                                            ">
                                                <%= previousRole %>
                                            </span>
                                        </td>
                                    </tr>

                                    <!-- New Role -->
                                    <tr>
                                        <td style="padding: 8px 0; border-top: 1px solid #1a4a4a;">
                                            <span style="color:#3a6b66; font-size:13px;">✅ New Role</span>
                                        </td>
                                        <td align="right" style="border-top: 1px solid #1a4a4a;">
                                            <span style="color:#00e5c0; font-size:13px; font-weight:600;">
                                                <%= newRole %>
                                            </span>
                                        </td>
                                    </tr>

                                    <!-- Time -->
                                    <tr>
                                        <td style="padding: 8px 0; border-top: 1px solid #1a4a4a;">
                                            <span style="color:#3a6b66; font-size:13px;">🕒 Updated At</span>
                                        </td>
                                        <td align="right" style="border-top: 1px solid #1a4a4a;">
                                            <span style="color:#00e5c0; font-size:13px; font-weight:600;">
                                                <%= time %>
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </td>
                    </tr>

                    <!-- New Role Badge -->
                    <tr>
                        <td align="center" style="padding: 0 40px 24px;">
                            <div style="
                                display: inline-block;
                                background: rgba(0,229,192,0.1);
                                border: 1px solid #00e5c0;
                                border-radius: 20px;
                                padding: 8px 24px;
                            ">
                                <span style="
                                    color: #00e5c0;
                                    font-size: 13px;
                                    font-weight: 700;
                                    letter-spacing: 2px;
                                    text-transform: uppercase;
                                ">⚡ You are now <%= newRole %></span>
                            </div>
                        </td>
                    </tr>

                    <!-- Warning -->
                    <tr>
                        <td align="center" style="padding: 0 40px 24px;">
                            <div style="
                                background: rgba(255,107,107,0.08);
                                border-left: 3px solid #ff6b6b;
                                border-radius: 6px;
                                padding: 12px 16px;
                                text-align: left;
                            ">
                                <p style="margin:0; color:#7ecfc4; font-size:13px;">
                                    ⚠️ If you did <strong style="color:#ff6b6b;">not</strong> expect this change,
                                    please contact support at
                                    <strong style="color:#00e5c0;">support@freightagent.com</strong>
                                </p>
                            </div>
                        </td>
                    </tr>

                    <!-- Divider -->
                    <tr>
                        <td style="padding: 0 40px;">
                            <hr style="border:none; border-top:1px solid #1a4a4a;" />
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="padding: 20px 40px 32px;">
                            <p style="margin:0; color:#3a6b66; font-size:12px;">
                                This is an automated notification from FreightAgent.<br />
                                &copy; 2026 FreightAgent. All rights reserved.
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

</body>

</html>