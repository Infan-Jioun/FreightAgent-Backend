<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Account Suspended - FreightAgent</title>
</head>

<body style="margin:0; padding:0; font-family: 'Segoe UI', Arial, sans-serif; background-color: #080c10;">

    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#080c10; padding: 40px 0;">
        <tr>
            <td align="center">
                <table width="520" cellpadding="0" cellspacing="0" style="
                    background: linear-gradient(145deg, #131722, #181d2a);
                    border-radius: 16px;
                    border: 1px solid #2a1f28;
                    overflow: hidden;
                    box-shadow: 0 0 50px rgba(255, 77, 79, 0.12);
                ">
                    <!-- Top accent bar (Alert Crimson) -->
                    <tr>
                        <td style="height: 4px; background: linear-gradient(90deg, #ff4d4f, #ff7875, #d9363e);"></td>
                    </tr>

                    <!-- Logo -->
                    <tr>
                        <td align="center" style="padding: 36px 40px 0;">
                            <div style="
                                display: inline-block;
                                background: linear-gradient(135deg, #2a1520, #381a26);
                                border: 1px solid #ff4d4f40;
                                border-radius: 12px;
                                padding: 10px 20px;
                            ">
                                <span style="color: #ff7875; font-size: 18px; font-weight: 800; letter-spacing: 1px;">
                                    ⚓ FreightAgent
                                </span>
                            </div>
                        </td>
                    </tr>

                    <!-- Icon -->
                    <tr>
                        <td align="center" style="padding: 28px 40px 0;">
                            <div style="
                                display: inline-block;
                                width: 72px;
                                height: 72px;
                                line-height: 72px;
                                background: rgba(255, 77, 79, 0.12);
                                border: 2px solid rgba(255, 77, 79, 0.35);
                                border-radius: 50%;
                                font-size: 34px;
                                text-align: center;
                            ">🚫</div>
                        </td>
                    </tr>

                    <!-- Title -->
                    <tr>
                        <td align="center" style="padding: 20px 40px 0;">
                            <h1 style="
                                margin: 0;
                                color: #fff1f0;
                                font-size: 24px;
                                font-weight: 700;
                                letter-spacing: 0.5px;
                            ">Account Suspended</h1>
                            <p style="margin: 10px 0 0; color: #ffa39e; font-size: 14px; line-height: 1.6;">
                                Hello <strong style="color: #ffffff;"><%= name %></strong>,<br/>
                                Your FreightAgent account has been suspended by an administrator.
                            </p>
                        </td>
                    </tr>

                    <!-- Suspension Details Box -->
                    <tr>
                        <td align="center" style="padding: 28px 40px;">
                            <div style="
                                background: #0c0f17;
                                border: 1px solid #2f1d24;
                                border-radius: 12px;
                                padding: 24px 28px;
                                text-align: left;
                            ">
                                <p style="
                                    margin: 0 0 16px;
                                    color: #ff7875;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 2px;
                                    text-transform: uppercase;
                                ">Suspension Notice Details</p>

                                <table width="100%" cellpadding="0" cellspacing="0">
                                    <!-- Name -->
                                    <tr>
                                        <td style="padding: 10px 0; color: #8c8c8c; font-size: 13px;">
                                            👤 Account Name
                                        </td>
                                        <td align="right" style="padding: 10px 0; color: #f0f0f0; font-size: 13px; font-weight: 600;">
                                            <%= name %>
                                        </td>
                                    </tr>

                                    <!-- Email -->
                                    <tr>
                                        <td style="padding: 10px 0; border-top: 1px solid #1f1f2e; color: #8c8c8c; font-size: 13px;">
                                            ✉️ Email Address
                                        </td>
                                        <td align="right" style="padding: 10px 0; border-top: 1px solid #1f1f2e; color: #f0f0f0; font-size: 13px; font-weight: 600;">
                                            <%= email %>
                                        </td>
                                    </tr>

                                    <!-- Status -->
                                    <tr>
                                        <td style="padding: 10px 0; border-top: 1px solid #1f1f2e; color: #8c8c8c; font-size: 13px;">
                                            ⚡ Account Status
                                        </td>
                                        <td align="right" style="padding: 10px 0; border-top: 1px solid #1f1f2e;">
                                            <span style="
                                                display: inline-block;
                                                background: rgba(255, 77, 79, 0.2);
                                                color: #ff4d4f;
                                                border: 1px solid rgba(255, 77, 79, 0.4);
                                                padding: 2px 10px;
                                                border-radius: 9999px;
                                                font-size: 11px;
                                                font-weight: 700;
                                                letter-spacing: 1px;
                                            ">SUSPENDED</span>
                                        </td>
                                    </tr>

                                    <!-- Reason -->
                                    <tr>
                                        <td style="padding: 10px 0; border-top: 1px solid #1f1f2e; color: #8c8c8c; font-size: 13px; vertical-align: top;">
                                            📋 Reason
                                        </td>
                                        <td align="right" style="padding: 10px 0; border-top: 1px solid #1f1f2e; color: #ff7875; font-size: 13px; font-weight: 500; max-width: 250px; word-break: break-word;">
                                            <%= reason %>
                                        </td>
                                    </tr>

                                    <!-- Timestamp -->
                                    <tr>
                                        <td style="padding: 10px 0; border-top: 1px solid #1f1f2e; color: #8c8c8c; font-size: 13px;">
                                            ⏰ Date & Time
                                        </td>
                                        <td align="right" style="padding: 10px 0; border-top: 1px solid #1f1f2e; color: #d9d9d9; font-size: 12px;">
                                            <%= time %>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </td>
                    </tr>

                    <!-- Alert / Advisory Notice -->
                    <tr>
                        <td style="padding: 0 40px 24px;">
                            <div style="
                                background: rgba(255, 77, 79, 0.06);
                                border-left: 3px solid #ff4d4f;
                                border-radius: 0 8px 8px 0;
                                padding: 12px 16px;
                                color: #cf1322;
                                font-size: 12px;
                                line-height: 1.5;
                            ">
                                <span style="color: #ffa39e;">
                                    ⚠️ All active sessions associated with this account have been terminated immediately. You will not be able to sign in or perform operations until the suspension is resolved.
                                </span>
                            </div>
                        </td>
                    </tr>

                    <!-- Support Contact -->
                    <tr>
                        <td align="center" style="padding: 0 40px 36px;">
                            <p style="margin: 0 0 12px; color: #8c8c8c; font-size: 13px;">
                                If you believe this action was taken in error or wish to appeal:
                            </p>
                            <a href="mailto:support@freightagent.com" style="
                                display: inline-block;
                                background: linear-gradient(135deg, #ff4d4f, #d9363e);
                                color: #ffffff;
                                text-decoration: none;
                                font-size: 13px;
                                font-weight: 600;
                                padding: 10px 24px;
                                border-radius: 8px;
                                box-shadow: 0 4px 14px rgba(255, 77, 79, 0.3);
                            ">Contact Support Team</a>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="
                            padding: 24px 40px;
                            background-color: #0c0f17;
                            border-top: 1px solid #1f1f2e;
                        ">
                            <p style="margin: 0; color: #595959; font-size: 12px;">
                                © <%= new Date().getFullYear() %> FreightAgent Logistics Inc. All rights reserved.
                            </p>
                            <p style="margin: 6px 0 0; color: #434343; font-size: 11px;">
                                This is an automated security notification. Please do not reply directly to this email.
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

</body>

</html>
