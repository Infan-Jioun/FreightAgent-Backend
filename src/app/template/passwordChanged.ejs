<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Changed</title>
</head>

<body style="margin:0; padding:0; font-family: 'Segoe UI', Arial, sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#0a0f0f; padding: 40px 0;">
        <tr>
            <td align="center">

                <!-- Card -->
                <table width="520" cellpadding="0" cellspacing="0" style="
                    background: linear-gradient(145deg, #0d1f1f, #112a2a);
                    border-radius: 16px;
                    border: 1px solid #1a4a4a;
                    overflow: hidden;
                    box-shadow: 0 0 40px rgba(0,200,180,0.08);
                ">

                    <!-- Top accent bar -->
                    <tr>
                        <td style="
                            height: 4px;
                            background: linear-gradient(90deg, #00c9a7, #00e5c0, #00b4d8);
                        "></td>
                    </tr>

                    <!-- Logo / Brand -->
                    <tr>
                        <td align="center" style="padding: 36px 40px 0;">
                            <div style="
                                display: inline-block;
                                background: linear-gradient(135deg, #00c9a7, #00b4d8);
                                border-radius: 12px;
                                padding: 10px 20px;
                            ">
                                <span style="
                                    color: #0a0f0f;
                                    font-size: 18px;
                                    font-weight: 800;
                                    letter-spacing: 1px;
                                ">⚓ FreightAgent</span>
                            </div>
                        </td>
                    </tr>

                    <!-- Success Icon -->
                    <tr>
                        <td align="center" style="padding: 28px 40px 0;">
                            <div style="
                                width: 64px;
                                height: 64px;
                                background: linear-gradient(135deg, #00c9a7, #00b4d8);
                                border-radius: 50%;
                                display: inline-flex;
                                align-items: center;
                                justify-content: center;
                                font-size: 28px;
                                line-height: 64px;
                                text-align: center;
                            ">✓</div>
                        </td>
                    </tr>

                    <!-- Title -->
                    <tr>
                        <td align="center" style="padding: 20px 40px 0;">
                            <h1 style="
                                margin: 0;
                                color: #e0faf5;
                                font-size: 24px;
                                font-weight: 700;
                                letter-spacing: 0.5px;
                            ">Password Changed Successfully</h1>
                            <p style="
                                margin: 10px 0 0;
                                color: #7ecfc4;
                                font-size: 14px;
                            ">Hello, <strong style="color:#00e5c0;">
                                    <%= name %>
                                </strong>! Your password has been updated successfully.</p>
                        </td>
                    </tr>

                    <!-- Info Box -->
                    <tr>
                        <td align="center" style="padding: 32px 40px;">
                            <div style="
                                background: #0a1a1a;
                                border: 2px solid #00c9a7;
                                border-radius: 12px;
                                padding: 24px 32px;
                                text-align: left;
                            ">
                                <p style="
                                    margin: 0 0 12px;
                                    color: #7ecfc4;
                                    font-size: 12px;
                                    letter-spacing: 2px;
                                    text-transform: uppercase;
                                ">Account Activity</p>

                                <table width="100%" cellpadding="0" cellspacing="0">
                                    <tr>
                                        <td style="padding: 6px 0;">
                                            <span style="color:#3a6b66; font-size:13px;">🕒 Time</span>
                                        </td>
                                        <td align="right">
                                            <span style="color:#00e5c0; font-size:13px; font-weight:600;">
                                                <%= time %>
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 6px 0; border-top: 1px solid #1a4a4a;">
                                            <span style="color:#3a6b66; font-size:13px;">📧 Email</span>
                                        </td>
                                        <td align="right" style="border-top: 1px solid #1a4a4a;">
                                            <span style="color:#00e5c0; font-size:13px; font-weight:600;">
                                                <%= email %>
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 6px 0; border-top: 1px solid #1a4a4a;">
                                            <span style="color:#3a6b66; font-size:13px;">🔒 Status</span>
                                        </td>
                                        <td align="right" style="border-top: 1px solid #1a4a4a;">
                                            <span style="color:#00e5c0; font-size:13px; font-weight:600;">All sessions
                                                logged out</span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </td>
                    </tr>

                    <!-- Warning -->
                    <tr>
                        <td align="center" style="padding: 0 40px 24px;">
                            <div style="
                                background: rgba(255,80,80,0.08);
                                border-left: 3px solid #ff5050;
                                border-radius: 6px;
                                padding: 12px 16px;
                                text-align: left;
                            ">
                                <p style="margin:0; color:#7ecfc4; font-size:13px;">
                                    ⚠️ If you did <strong style="color:#ff5050;">not</strong> make this change,
                                    please contact our support immediately at
                                    <strong style="color:#00e5c0;">support@freightagent.com</strong>
                                </p>
                            </div>
                        </td>
                    </tr>

                    <!-- Divider -->
                    <tr>
                        <td style="padding: 0 40px;">
                            <hr style="border:none; border-top:1px solid #1a4a4a;" />
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="padding: 20px 40px 32px;">
                            <p style="margin:0; color:#3a6b66; font-size:12px;">
                                This is an automated security notification.<br />
                                &copy; 2026 FreightAgent. All rights reserved.
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

</body>

</html>