<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Successful - FreightAgent</title>
</head>
<body style="margin:0; padding:0; font-family: 'Segoe UI', Arial, sans-serif; background-color:#0a0f0f;">

    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#0a0f0f; padding: 40px 0;">
        <tr>
            <td align="center">
                <table width="560" cellpadding="0" cellspacing="0" style="
                    background: linear-gradient(145deg, #0d1f1f, #112a2a);
                    border-radius: 16px;
                    border: 1px solid #1a4a4a;
                    overflow: hidden;
                    box-shadow: 0 0 40px rgba(0,200,180,0.08);
                ">
                    <!-- Top accent bar -->
                    <tr>
                        <td style="
                            height: 5px;
                            background: linear-gradient(90deg, #10b981, #00c9a7, #00b4d8);
                        "></td>
                    </tr>

                    <!-- Logo -->
                    <tr>
                        <td align="center" style="padding: 32px 40px 0;">
                            <div style="
                                display: inline-block;
                                background: linear-gradient(135deg, #00c9a7, #00b4d8);
                                border-radius: 12px;
                                padding: 10px 22px;
                            ">
                                <span style="
                                    color: #0a0f0f;
                                    font-size: 18px;
                                    font-weight: 800;
                                    letter-spacing: 1px;
                                ">⚓ FreightAgent</span>
                            </div>
                        </td>
                    </tr>

                    <!-- Success Icon -->
                    <tr>
                        <td align="center" style="padding: 24px 40px 0;">
                            <div style="
                                width: 64px;
                                height: 64px;
                                line-height: 64px;
                                border-radius: 50%;
                                background: rgba(16, 185, 129, 0.15);
                                border: 1px solid #10b981;
                                font-size: 32px;
                                text-align: center;
                            ">
                                ✓
                            </div>
                        </td>
                    </tr>

                    <!-- Title -->
                    <tr>
                        <td align="center" style="padding: 16px 40px 0;">
                            <h1 style="
                                margin: 0;
                                color: #e0faf5;
                                font-size: 24px;
                                font-weight: 700;
                            ">Payment Confirmed!</h1>
                            <p style="
                                margin: 8px 0 0;
                                color: #7ab8b0;
                                font-size: 14px;
                                line-height: 1.5;
                            ">Hello <%= customerName %>, your payment has been processed successfully.</p>
                        </td>
                    </tr>

                    <!-- Details Card -->
                    <tr>
                        <td style="padding: 24px 40px 0;">
                            <div style="
                                background: rgba(0, 0, 0, 0.35);
                                border: 1px solid #1a3838;
                                border-radius: 12px;
                                padding: 20px 24px;
                            ">
                                <table width="100%" cellpadding="6" cellspacing="0" style="color: #cbd5e1; font-size: 13.5px;">
                                    <tr>
                                        <td style="color: #7ab8b0; width: 40%;">Tracking Number:</td>
                                        <td style="color: #e0faf5; font-weight: 600; text-align: right;"><%= trackingId %></td>
                                    </tr>
                                    <tr>
                                        <td style="color: #7ab8b0;">Route:</td>
                                        <td style="color: #e0faf5; text-align: right;"><%= origin %> ➔ <%= destination %></td>
                                    </tr>
                                    <tr>
                                        <td style="color: #7ab8b0;">Cargo Weight:</td>
                                        <td style="color: #e0faf5; text-align: right;"><%= weight %> KG</td>
                                    </tr>
                                    <tr>
                                        <td style="color: #7ab8b0;">Payment Status:</td>
                                        <td style="color: #10b981; font-weight: 700; text-align: right;">PAID (Verified)</td>
                                    </tr>
                                    <tr>
                                        <td colspan="2" style="border-top: 1px solid #1a3838; padding-top: 12px;"></td>
                                    </tr>
                                    <tr>
                                        <td style="color: #e0faf5; font-size: 15px; font-weight: 700;">Amount Paid:</td>
                                        <td style="color: #00c9a7; font-size: 18px; font-weight: 800; text-align: right;">
                                            $<%= Number(amount).toFixed(2) %> USD
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </td>
                    </tr>

                    <!-- Invoice CTA -->
                    <tr>
                        <td align="center" style="padding: 28px 40px 0;">
                            <% if (invoiceUrl) { %>
                            <a href="<%= invoiceUrl %>" target="_blank" style="
                                display: inline-block;
                                background: linear-gradient(135deg, #00c9a7, #00b4d8);
                                color: #0a0f0f;
                                font-weight: 700;
                                font-size: 14px;
                                text-decoration: none;
                                padding: 12px 28px;
                                border-radius: 8px;
                                letter-spacing: 0.5px;
                            ">
                                📄 View / Download Stored Receipt
                            </a>
                            <% } %>
                            <p style="
                                margin: 14px 0 0;
                                color: #7ab8b0;
                                font-size: 12px;
                            ">
                                📎 An official PDF invoice has been attached directly to this email for your records.
                            </p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="padding: 32px 40px 24px; border-top: 1px solid #143030; margin-top: 24px;">
                            <p style="
                                margin: 0;
                                color: #4a7570;
                                font-size: 11.5px;
                                text-align: center;
                                line-height: 1.6;
                            ">
                                FreightAgent Global Logistics • Automated Billing Notification<br/>
                                If you have questions regarding this payment, please reply to this email or reach us at support@freightagent.com
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

</body>
</html>
