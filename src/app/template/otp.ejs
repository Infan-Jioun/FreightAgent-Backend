<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OTP Verification</title>
</head>

<body style="margin:0; padding:0; font-family: 'Segoe UI', Arial, sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#0a0f0f; padding: 40px 0;">
        <tr>
            <td align="center">

                <!-- Card -->
                <table width="520" cellpadding="0" cellspacing="0" style="
          background: linear-gradient(145deg, #0d1f1f, #112a2a);
          border-radius: 16px;
          border: 1px solid #1a4a4a;
          overflow: hidden;
          box-shadow: 0 0 40px rgba(0,200,180,0.08);
        ">

                    <!-- Top accent bar -->
                    <tr>
                        <td style="
              height: 4px;
              background: linear-gradient(90deg, #00c9a7, #00e5c0, #00b4d8);
            "></td>
                    </tr>

                    <!-- Logo / Brand -->
                    <tr>
                        <td align="center" style="padding: 36px 40px 0;">
                            <div style="
                display: inline-block;
                background: linear-gradient(135deg, #00c9a7, #00b4d8);
                border-radius: 12px;
                padding: 10px 20px;
              ">
                                <span style="
                  color: #0a0f0f;
                  font-size: 18px;
                  font-weight: 800;
                  letter-spacing: 1px;
                ">⚓ FreightAgent</span>
                            </div>
                        </td>
                    </tr>

                    <!-- Title -->
                    <tr>
                        <td align="center" style="padding: 28px 40px 0;">
                            <h1 style="
                margin: 0;
                color: #e0faf5;
                font-size: 24px;
                font-weight: 700;
                letter-spacing: 0.5px;
              ">Verify Your Email</h1>
                            <p style="
                margin: 10px 0 0;
                color: #7ecfc4;
                font-size: 14px;
              ">Hello, <strong style="color:#00e5c0;">
                                    <%= name %>
                                </strong>! Use the OTP below to verify your account.</p>
                        </td>
                    </tr>

                    <!-- OTP Box -->
                    <tr>
                        <td align="center" style="padding: 32px 40px;">
                            <div style="
                background: #0a1a1a;
                border: 2px dashed #00c9a7;
                border-radius: 12px;
                padding: 24px 40px;
                display: inline-block;
              ">
                                <p style="
                  margin: 0 0 6px;
                  color: #7ecfc4;
                  font-size: 12px;
                  letter-spacing: 2px;
                  text-transform: uppercase;
                ">Your OTP Code</p>
                                <h2 style="
                  margin: 0;
                  font-size: 42px;
                  font-weight: 900;
                  letter-spacing: 10px;
                  color: #00e5c0;
                  text-shadow: 0 0 20px rgba(0,229,192,0.4);
                ">
                                    <%= otp %>
                                </h2>
                            </div>
                        </td>
                    </tr>

                    <!-- Warning -->
                    <tr>
                        <td align="center" style="padding: 0 40px 16px;">
                            <div style="
                background: rgba(0,180,216,0.08);
                border-left: 3px solid #00b4d8;
                border-radius: 6px;
                padding: 12px 16px;
                text-align: left;
              ">
                                <p style="margin:0; color:#7ecfc4; font-size:13px;">
                                    ⏱ This code expires in <strong style="color:#00e5c0;">10 minutes</strong>.
                                    Do not share this code with anyone.
                                </p>
                            </div>
                        </td>
                    </tr>

                    <!-- Divider -->
                    <tr>
                        <td style="padding: 0 40px;">
                            <hr style="border:none; border-top:1px solid #1a4a4a;" />
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="padding: 20px 40px 32px;">
                            <p style="margin:0; color:#3a6b66; font-size:12px;">
                                If you didn't request this, please ignore this email.<br />
                                &copy; 2026 FreightAgent. All rights reserved.
                            </p>
                        </td>
                    </tr>

                </table>
                <!-- End Card -->

            </td>
        </tr>
    </table>

</body>

</html>