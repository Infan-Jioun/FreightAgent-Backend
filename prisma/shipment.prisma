model Shipment {
  id                    String         @id @default(uuid())
  trackingId            String         @unique @default(uuid())
  userId                String
  agentId               String?
  assignedById          String?
  assignedAt            DateTime?
  origin                String
  destination           String
  originLocationId      String?
  destinationLocationId String?
  weight                Float
  declaredCargoValue    Float          @default(0)
  description           String?
  status                ShipmentStatus @default(PENDING)
  estimatedDate         DateTime?
  acceptedAt            DateTime?
  paymentStatus         PaymentStatus  @default(UNPAID)
  stripePaymentIntentId String?        @unique
  stripeRefundId        String?
  paidAt                DateTime?
  invoiceUrl            String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  updateBy              String?
  cost                  ShipmentCost?
  agent                 User?          @relation("AgentShipments", fields: [agentId], references: [id])
  assignedBy            User?          @relation("AssignedShipments", fields: [assignedById], references: [id])
  user                  User           @relation("CustomerShipments", fields: [userId], references: [id], onDelete: Cascade)
  statusLogs            StatusLog[]
  originLocation        Location?      @relation("ShipmentOriginLocation", fields: [originLocationId], references: [id], onDelete: SetNull)
  destinationLocation   Location?      @relation("ShipmentDestinationLocation", fields: [destinationLocationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([agentId])
  @@index([assignedById])
  @@index([status])
  @@index([paymentStatus])
  @@index([trackingId])
  @@map("shipments")
}

model ShipmentCost {
  id                  String   @id @default(uuid())
  shipmentId          String   @unique
  originHandling      Float
  oceanFreight        Float
  bafSurcharge        Float
  thcOrigin           Float
  thcDestination      Float
  transshipmentFee    Float
  customsClearance    Float
  customsDuty         Float
  vat                 Float
  destinationHandling Float
  cargoInsurance      Float
  lastMileDelivery    Float
  agencyFee           Float
  platformFee         Float
  totalCost           Float
  currency            String   @default("USD")
  exchangeRate        Float    @default(1.0)
  convertedTotal      Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  shipment            Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([currency])
  @@map("shipment_costs")
}

model StatusLog {
  id            String         @id @default(uuid())
  shipmentId    String
  status        ShipmentStatus
  location      String
  note          String?
  updateBy      String?
  createdAt     DateTime       @default(now())
  shipment      Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  updatedByUser User?          @relation("StatusLogUpdater", fields: [updateBy], references: [id])

  @@index([shipmentId, createdAt])
  @@map("status_logs")
}

model Withdrawal {
  id               String           @id @default(uuid())
  withdrawalNumber String           @unique @default(uuid())
  agentId          String
  amount           Float
  currency         String           @default("USD")
  status           WithdrawalStatus @default(COMPLETED)
  bankInfo         String?
  receiptUrl       String?
  note             String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  agent            User             @relation("AgentWithdrawals", fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([status])
  @@map("withdrawals")
}
