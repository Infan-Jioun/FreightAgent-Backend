model AgentCredential {
    id                 String           @id @default(uuid())
    agentId            String
    agent              User             @relation("AgentCredentials", fields: [agentId], references: [id], onDelete: Cascade)
    type               CredentialType
    documentNumber     String
    cloudinaryPublicId String
    documentUrl        String
    issuingAuthority   String?
    issueDate          DateTime?
    expiryDate         DateTime?
    status             CredentialStatus @default(PENDING)
    rejectionReason    String?
    verifiedById       String?
    verifiedBy         User?            @relation("CredentialsVerified", fields: [verifiedById], references: [id], onDelete: SetNull)
    verifiedAt         DateTime?
    createdAt          DateTime         @default(now())
    updatedAt          DateTime         @updatedAt

    @@unique([agentId, type])
    @@index([agentId])
    @@index([status])
    @@index([expiryDate])
    @@map("agent_credentials")
}
