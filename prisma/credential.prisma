model AgentCredential {
  id                 String           @id @default(uuid())
  agentId            String
  type               CredentialType
  documentNumber     String
  cloudinaryPublicId String
  documentUrl        String
  issuingAuthority   String?
  issueDate          DateTime?
  expiryDate         DateTime?
  status             CredentialStatus @default(PENDING)
  rejectionReason    String?
  verifiedById       String?
  verifiedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  agent              User             @relation("AgentCredentials", fields: [agentId], references: [id], onDelete: Cascade)
  verifiedBy         User?            @relation("CredentialsVerified", fields: [verifiedById], references: [id])

  @@unique([agentId, type])
  @@index([agentId])
  @@index([status])
  @@index([expiryDate])
  @@map("agent_credentials")
}
