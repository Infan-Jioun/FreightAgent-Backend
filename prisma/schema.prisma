generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  AT_CUSTOMS
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

